# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
coverage
*.local

# This project is pnpm only. A stray npm lockfile makes tooling pick the wrong
# package manager, so it is ignored rather than committed.
package-lock.json

# Harvested SAGIS parcel data. Roughly 14MB across three files, rebuilt by
# `pnpm sagis:harvest`, and destined for Postgres rather than for git.
# src/lib/parcels/coverage-manifest.json IS committed: it is what makes the
# coverage reviewable in a diff.
data/
public/parcels/

# Environment. Never commit real credentials, .env.example carries placeholders.
.env
.env.local
.env.*.local
.env.production

# Supabase CLI local state
supabase/.temp
supabase/.branches

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
